# Starts onboard/gps_ws_server.py on boot.
# Change --name (and the paths) for each drone, then:
#   sudo cp config/gps-ws.service /etc/systemd/system/gps-ws.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gps-ws
[Unit]
Description=GPS WebSocket server
After=network-online.target mavlink-router.service
Wants=network-online.target

[Service]
ExecStart=/home/pilot/venv/bin/python /home/pilot/helicarrier/onboard/gps_ws_server.py --name megadrone
User=pilot
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
